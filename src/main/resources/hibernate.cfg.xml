<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Driver de la base de datos.
             La URL, el usuario y la contraseña NO van aquí: se leen de variables
             de entorno en HibernateUtil (DB_URL, DB_USER, DB_PASSWORD). -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>

        <!-- Dialecto de la base de datos -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Mostrar SQL en consola -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Estrategia de actualización del esquema -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Mapeo de todas las clases -->
        <mapping class="model.User"/>
        <mapping class="model.Product"/>
        <mapping class="model.Profile"/>
    </session-factory>
</hibernate-configuration>
